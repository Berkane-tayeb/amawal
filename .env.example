# MongoDB (Atlas : mongodb+srv://user:pass@cluster/... ou local : mongodb://localhost:27017/amawal)
MONGODB_URI=mongodb://localhost:27017/amawal

# Secret pour signer les sessions JWT (openssl rand -base64 32)
SESSION_SECRET=

# Compte admin créé par le seed (npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-moi-123
